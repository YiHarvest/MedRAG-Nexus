APP_MODE=dev
APP_HOST=0.0.0.0
APP_PORT=28111
APP_LOG_LEVEL=info

# Sudo 密码（仅生产模式使用，用于 Docker 操作）
# SUDO_PASSWORD=
DATA_ROOT=./data
# 公开后端 API 与 MCP 共用下列 SQLite、ES 索引和 Milvus 集合。
SQLITE_PATH=./data/agenthub.sqlite3

# 自有 WebUI 的首个超级管理员。首次启动且账号表为空时创建；至少 3 个字符。
# 这与部署外层门锁 WEBUI_LOCK_PASSWORD 相互独立。
WEBUI_LOCK_PASSWORD=
# 默认不信任客户端可伪造的代理头。仅当 WebUI 确实位于受控反向代理后时开启。
WEBUI_TRUST_PROXY_HEADERS=false
# 受控代理层数，例如单层 Nginx 填 1；将从转发链右侧按此层数确定客户端地址。
WEBUI_TRUSTED_PROXY_HOPS=1
WEBUI_CLEANUP_RETRY_SECONDS=60
WEBUI_DELETION_LEASE_SECONDS=300
WEBUI_AGENT_ACTION_TTL_MINUTES=15
WEBUI_AGENT_ACTION_RETENTION_DAYS=30
WEBUI_AGENT_ARTIFACT_TTL_HOURS=24
WEBUI_AGENT_CLEANUP_INTERVAL_SECONDS=3600
WEBUI_SUPERADMIN_USERNAME=admin
WEBUI_SUPERADMIN_PASSWORD=
WEBUI_SUPERADMIN_DISPLAY_NAME=超级管理员
# 可选：全新部署时一次初始化多个超级管理员；设置后优先于上面三个单账号变量。
# WEBUI_SUPERADMINS_JSON='[{"login_name":"admin-a","display_name":"管理员 A","password":"请替换"},{"login_name":"admin-b","display_name":"管理员 B","password":"请替换"}]'
WEBUI_COOKIE_SECURE=false

MINERU_URL=
MINERU_API_PATH=/file_parse
MINERU_BACKEND=pipeline
MINERU_METHOD=auto
MINERU_LANG=ch
MINERU_MAX_CONCURRENCY=8
MINERU_HTTP_TIMEOUT_SECONDS=1800
FILE_INGESTION_CONCURRENCY=1

MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TOKEN=
MILVUS_COLLECTION=jd_knowledge_v3_chunks
LEGACY_MILVUS_COLLECTION=jd_knowledge_v2_chunks

ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_WORKSPACE_INDEX=jd_knowledge_v3_workspaces
ELASTICSEARCH_DOCUMENT_INDEX=jd_knowledge_v3_resources
ELASTICSEARCH_CHUNK_INDEX=jd_knowledge_v3_chunks
LEGACY_ELASTICSEARCH_INDICES=jd_knowledge_v2_workspaces,jd_knowledge_v2_documents,jd_knowledge_v2_chunks,jd_knowledge_v2_tasks

REDIS_URL=redis://127.0.0.1:20002/0
WORKER_CONCURRENCY=4
REDIS_QUEUE_NAME=knowledge:tasks

# WebUI 复用上面的 ES、Milvus、Redis 地址和认证信息，
# 只通过独立 SQLite、文件目录、索引、集合和任务队列隔离数据。
WEBUI_DATA_ROOT=./data/webui
WEBUI_SQLITE_PATH=./data/webui/jd_knowledge_webui.sqlite3
WEBUI_ELASTICSEARCH_WORKSPACE_INDEX=jd_knowledge_webui_workspaces
WEBUI_ELASTICSEARCH_DOCUMENT_INDEX=jd_knowledge_webui_resources
WEBUI_ELASTICSEARCH_CHUNK_INDEX=jd_knowledge_webui_chunks
WEBUI_MILVUS_COLLECTION=jd_knowledge_webui_chunks
WEBUI_REDIS_QUEUE_NAME=knowledge:webui:tasks

# WebUI 审计日志按日保存为 JSONL，默认保留 3 个自然月。
WEBUI_AUDIT_LOG_DIR=./data/audit/webui
WEBUI_AUDIT_LOG_RETENTION_MONTHS=3

TASK_TIMEOUT_SECONDS=3600
WORKSPACE_LOCK_TTL_SECONDS=60
WORKSPACE_LOCK_WAIT_SECONDS=300
RESERVATION_TTL_SECONDS=3900
STAGE_RETRY_COUNT=3

OPENAI_EMBEDDING_URL=http://localhost:11434/v1/embeddings
OPENAI_EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=64

RERANK_URL=
RERANK_API_KEY=
RERANK_MODEL=bge-reranker-v2-m3

LLM_URL=
LLM_MODEL=
LLM_KEY=
LLM_THINKING_ENABLED=false
LLM_TIMEOUT_SECONDS=120
CHAT_ROUTER_MODEL=
CHAT_ROUTER_TIMEOUT_SECONDS=15
CHAT_ROUTER_MAX_TOKENS=96
CHAT_WORKSPACE_CONCURRENCY=4
CHAT_MAX_TOOL_CALLS=4

CHUNK_SIZE=512
CHUNK_OVERLAP=120
RETRIEVAL_DEFAULT_TOP_K=10
RETRIEVAL_MAX_TOP_K=50
RETRIEVAL_CANDIDATE_MULTIPLIER=5
RETRIEVAL_MIN_CANDIDATES=50
RETRIEVAL_MAX_CANDIDATES=200
RRF_K=60
RERANK_MAX_CANDIDATES=200

MAX_FILE_SIZE_MIB=50
MAX_TEXT_SIZE_MIB=10
TASK_RETENTION_DAYS=30
DEPENDENCY_TIMEOUT_SECONDS=3
MIGRATION_MARKER=v3_legacy_cleanup_complete
